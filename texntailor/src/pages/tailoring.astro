---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/content';
import { site, whatsappLink } from '../data/site';

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tailoring at Tex N Tailor',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service', name: s.title, description: s.lede, serviceType: 'Tailoring', areaServed: 'Dubai',
      provider: { '@id': `${site.url}/#business` }, url: `${site.url}/tailoring/#${s.id}`,
    },
  })),
}];
---
<Base
  title="Tailoring: Custom Suits, Wedding Attire & Everyday Wear in Dubai"
  description="Custom suits, wedding attire and everyday clothing made to your measurements at Tex N Tailor, Al Nahda 1, Dubai. See what we make and how to start."
  schema={schema}
>
  <PageIntro
    kicker="Tailoring"
    title='Made for the life <span class="soft">you actually lead.</span>'
    lede="Three kinds of work, one principle: every piece is made to your measurements, in the cloth and details you choose."
  >
    <nav class="toc" aria-label="On this page">
      {services.map((s, i) => (
        <a href={`#${s.id}`}><span class="toc__i">0{i + 1}</span>{s.title}</a>
      ))}
    </nav>
  </PageIntro>

  {services.map((s, i) => (
    <section id={s.id} class="svcp section" aria-labelledby={`h-${s.id}`}>
      <div class:list={['wrap svcp__grid', { 'svcp__grid--flip': i % 2 === 1 }]}>
        <div class="svcp__media">
          <Photo slot={s.hero} ratio="portrait" sizes="(min-width: 1024px) 45vw, 100vw" />
        </div>
        <div class="svcp__text">
          <p class="eyebrow" data-reveal>0{i + 1} · {s.occasion}</p>
          <h2 id={`h-${s.id}`} class="display h-lg" data-reveal>{s.title}</h2>
          <p class="svcp__lede" data-reveal>{s.lede}</p>
          {s.body.map((p) => <p class="muted svcp__p" data-reveal>{p}</p>)}

          <div class="svcp__decide" data-reveal>
            <p class="svcp__h">What you decide</p>
            <ul>{s.decisions.map((d) => <li>{d}</li>)}</ul>
          </div>

          <div class="btn-row" data-reveal>
            <a class="btn" href={`/contact/?service=${s.id}#enquire`}>Enquire about {s.title.toLowerCase()}</a>
            <a class="btn btn--soft" href={whatsappLink(`Hello Tex N Tailor, I would like to ask about ${s.title.toLowerCase()}.`)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <CtaBand title="Not sure where to start?" text="Bring an idea, a photo or a garment you love. We will help you work out the rest." />
</Base>

<style>
  .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .toc a { display: inline-flex; gap: 0.6rem; align-items: center; min-height: 48px; padding: 0 1.25rem; border-radius: 999px; background: var(--soft); font-size: 0.92rem; font-weight: 500; transition: background-color 0.3s; }
  .toc a:hover { background: var(--soft-2); }
  .toc__i { color: var(--muted); font-weight: 400; font-size: 0.8rem; }
  .svcp__grid { display: grid; grid-template-columns: 6fr 5fr; gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .svcp__grid--flip .svcp__media { order: 2; }
  .svcp__media { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .svcp__text h2 { margin-bottom: 1.5rem; }
  .svcp__lede { font-size: var(--step-1); line-height: 1.55; margin-bottom: 1.25rem; max-width: 36ch; }
  .svcp__p { max-width: 52ch; }
  .svcp__decide { margin: 2.25rem 0; padding: clamp(1.4rem, 3vw, 2rem); background: var(--soft); border-radius: var(--r); }
  .svcp__h { font-size: 0.85rem; font-weight: 500; margin-bottom: 1rem; }
  .svcp__decide ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .svcp__decide li { padding: 0.55rem 1rem; border-radius: 999px; background: var(--white); font-size: 0.9rem; }
  @media (max-width: 900px) {
    .svcp__grid { grid-template-columns: 1fr; }
    .svcp__grid--flip .svcp__media { order: 0; }
    .svcp__media { position: static; }
    .btn-row .btn { flex: 1 1 auto; }
  }
</style>
