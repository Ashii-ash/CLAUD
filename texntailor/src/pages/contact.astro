---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Visit from '../components/Visit.astro';
import Icon from '../components/Icon.astro';
import { site, telLink, whatsappLink, mapsLink, addressLine } from '../data/site';
---
<Base
  title="Visit & Contact — Book a Tailoring Appointment in Al Nahda, Dubai"
  description="Book an appointment at Tex N Tailor, Al Nahda 1, Dubai. Send an enquiry, call, or message us on WhatsApp about custom suits, wedding attire and everyday tailoring."
>
  <PageIntro
    kicker="Visit & contact"
    title="Book an <em>appointment.</em>"
    lede="Tell us a little about what you need and when. We will reply to arrange a time for measurements and a conversation about cloth."
  />

  <section class="contact" id="enquire" aria-labelledby="enquire-title">
    <div class="wrap contact__grid">
      <div class="contact__form">
        <h2 id="enquire-title" class="sr-only">Enquiry form</h2>
        <EnquiryForm />
      </div>
      <aside class="contact__aside" aria-label="Direct contact">
        <p class="label muted">Prefer to talk?</p>
        <ul class="contact__lines">
          <li><a href={whatsappLink('Hello Tex N Tailor, I would like to book an appointment.')} target="_blank" rel="noopener"><Icon name="whatsapp" /><span><strong>WhatsApp</strong><span class="muted">Usually the quickest way to reach us</span></span></a></li>
          <li><a href={telLink}><Icon name="phone" /><span><strong>{site.contact.phoneDisplay}</strong><span class="muted">Call the studio</span></span></a></li>
          {site.contact.email && <li><a href={`mailto:${site.contact.email}`}><Icon name="mail" /><span><strong>{site.contact.email}</strong><span class="muted">Email</span></span></a></li>}
          <li><a href={mapsLink} target="_blank" rel="noopener"><Icon name="pin" /><span><strong>{addressLine}</strong><span class="muted">Get directions</span></span></a></li>
          <li><a href={site.social.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /><span><strong>{site.social.instagram.handle}</strong><span class="muted">Instagram</span></span></a></li>
        </ul>
      </aside>
    </div>
  </section>

  <Visit />
</Base>

<style>
  .contact { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .contact__grid { display: grid; grid-template-columns: 7fr 4fr; gap: clamp(3rem, 7vw, 8rem); align-items: start; }
  .contact__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--linen); }
  .contact__aside .label { margin-bottom: 1rem; }
  .contact__lines li + li { border-top: 1px solid var(--line); }
  .contact__lines a { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem 0; text-decoration: none; }
  .contact__lines a > span { display: grid; gap: 0.15rem; min-width: 0; }
  .contact__lines strong { font-weight: 500; overflow-wrap: anywhere; }
  .contact__lines .muted { font-size: 0.88rem; }
  .contact__lines svg { flex: none; margin-top: 0.15rem; color: var(--claret); }
  .contact__lines a:hover strong { text-decoration: underline; }
  @media (max-width: 1000px) { .contact__grid { grid-template-columns: 1fr; } .contact__aside { position: static; order: -1; } }
</style>
