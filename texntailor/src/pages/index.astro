---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Tape from '../components/Tape.astro';
import Icon from '../components/Icon.astro';
import Visit from '../components/Visit.astro';
import CtaBand from '../components/CtaBand.astro';
import Scene3D from '../components/Scene3D.astro';
import { services, processSteps, details, lookbook, testimonials } from '../data/content';
import { site, whatsappLink } from '../data/site';

const [suits, wedding, everyday] = services;
const featured = lookbook;
---
<Base
  title="Tex N Tailor | Bespoke Tailor in Al Nahda, Dubai. Custom Suits & Wedding Attire"
  description="Tex N Tailor is a tailoring studio in Al Nahda 1, Dubai, making custom suits, wedding attire and everyday clothing to your measurements. Book an appointment or message us on WhatsApp."
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage">
      <Scene3D kind="cloth" label="Navy suiting cloth draping in the light, with mother-of-pearl and horn suit buttons" />
    </div>
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow" data-reveal>Bespoke tailoring in Al Nahda, Dubai</p>
        <h1 id="hero-title" class="display h-xl hero__title" data-reveal data-reveal-delay="1">
          Made to your measure.<span class="soft"> Cut for no one else.</span>
        </h1>
        <p class="lede hero__lede" data-reveal data-reveal-delay="2">
          Custom suits, wedding attire and everyday clothing, measured and made for you by the tailors at Tex&nbsp;N&nbsp;Tailor.
        </p>
        <div class="btn-row" data-reveal data-reveal-delay="3">
          <a class="btn" href="/contact/#enquire">Book an appointment</a>
          <a class="btn btn--soft" href={whatsappLink('Hello Tex N Tailor, I would like to enquire about tailoring.')} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp us</a>
        </div>
      </div>
    </div>
    <div class="wrap hero__foot">
      <nav class="hero__index" aria-label="Tailoring" data-reveal>
        {services.map((s, i) => (
          <a href={`/tailoring/#${s.id}`}>
            <span class="hero__i">0{i + 1}</span>
            <span class="hero__t">{s.title}</span>
            <span class="hero__o">{s.occasion}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="statement section" aria-label="Our approach">
    <div class="wrap">
      <p class="display statement__text" data-reveal>
        A good tailor listens before reaching for the tape.{' '}
        <span class="soft">Every garment we make begins with you: how you stand, how you move, and where you are going to wear it. Then come the measurements, the cloth and the cut.</span>
      </p>
    </div>
  </section>

  <!-- WHAT WE MAKE -->
  <section class="make" aria-labelledby="make-title">
    <div class="wrap">
      <Tape label="What we make" />
      <h2 id="make-title" class="display h-lg make__title" data-reveal>For the meeting, the occasion <span class="soft">and every day in between.</span></h2>

      <article class="svc svc--a" aria-labelledby="svc-suits">
        <div class="svc__media">
          <Photo slot={suits.hero} ratio="tall" sizes="(min-width: 1024px) 55vw, 100vw" />
          <div class="svc__inset"><Photo slot={suits.detail} ratio="square" sizes="(min-width: 1024px) 18vw, 40vw" /></div>
        </div>
        <div class="svc__text" data-reveal>
          <p class="svc__num">01</p>
          <p class="eyebrow">{suits.occasion}</p>
          <h3 id="svc-suits" class="display h-md">{suits.title}</h3>
          <p class="svc__lede">{suits.lede}</p>
          <p class="muted">{suits.body[0]}</p>
          <a class="link-arrow" href={`/tailoring/#${suits.id}`}>Custom suits</a>
        </div>
      </article>

      <article class="svc svc--b" aria-labelledby="svc-wedding">
        <div class="svc__text" data-reveal>
          <p class="svc__num">02</p>
          <p class="eyebrow">{wedding.occasion}</p>
          <h3 id="svc-wedding" class="display h-md">{wedding.title}</h3>
          <p class="svc__lede">{wedding.lede}</p>
          <p class="muted">{wedding.body[1]}</p>
          <a class="link-arrow" href={`/tailoring/#${wedding.id}`}>Wedding attire</a>
        </div>
        <div class="svc__media"><Photo slot={wedding.hero} ratio="portrait" sizes="(min-width: 1024px) 55vw, 100vw" /></div>
      </article>

      <article class="svc svc--c" aria-labelledby="svc-everyday">
        <Photo slot={everyday.hero} ratio="pano" sizes="100vw" />
        <div class="svc__cols" data-reveal>
          <div>
            <p class="svc__num">03</p>
            <p class="eyebrow">{everyday.occasion}</p>
            <h3 id="svc-everyday" class="display h-md">{everyday.title}</h3>
          </div>
          <div>
            <p class="svc__lede">{everyday.lede}</p>
            <p class="muted">{everyday.body[1]}</p>
            <a class="link-arrow" href={`/tailoring/#${everyday.id}`}>Everyday tailoring</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="proc section" aria-labelledby="proc-title">
    <div class="wrap">
      <div class="proc__card">
        <div class="proc__head">
          <div>
            <Tape label="How it works" />
            <h2 id="proc-title" class="display h-lg" data-reveal>From first conversation <span class="soft">to final fitting.</span></h2>
          </div>
          <a class="link-arrow" href="/process/" data-reveal>The full process</a>
        </div>
        <ol class="proc__track" tabindex="0" aria-label="Six steps">
          {processSteps.map((s, i) => (
            <li class="proc__step" data-reveal data-reveal-delay={String(i % 3)}>
              <span class="proc__n" data-n={s.n} aria-hidden="true"></span>
              <h3 class="proc__t">{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- DETAILS -->
  <section class="dets section" aria-labelledby="dets-title">
    <div class="wrap dets__grid">
      <div class="dets__stage" aria-hidden="true">
        <div class="dets__sticky">
          {details.map((d, i) => (
            <div class:list={['dets__img', { 'is-active': i === 0 }]} data-detail-img={i}>
              <Photo slot={d.slot} ratio="tall" reveal={false} sizes="(min-width: 1024px) 38vw, 1px" />
            </div>
          ))}
        </div>
      </div>
      <div class="dets__body">
        <Tape label="The details" />
        <h2 id="dets-title" class="display h-lg" data-reveal>Small decisions, <span class="soft">seen every day.</span></h2>
        <p class="lede dets__lede" data-reveal>Custom tailoring means choosing. These are some of the details you will decide on with us, with as much or as little guidance as you like.</p>
        <dl class="dets__list">
          {details.map((d, i) => (
            <div class="dets__item" data-detail={i} data-reveal>
              <dt>{d.term}</dt>
              <dd class="muted">{d.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="work section" aria-labelledby="work-title">
    <div class="wrap">
      <div class="work__head">
        <div>
          <Tape label="The lookbook" />
          <h2 id="work-title" class="display h-lg" data-reveal>Looks we make <span class="soft">for our clients.</span></h2>
          <p class="muted work__note" data-reveal>Illustrations of the kind of work we do. For finished pieces, see our portfolio.</p>
        </div>
        <a class="link-arrow" href="/work/" data-reveal>See the portfolio</a>
      </div>
      <div class="work__grid">
        {featured.map((w, i) => (
          <figure class={`work__item work__item--${i + 1}`}>
            <Photo slot={w} ratio="fill" sizes="(min-width: 1024px) 33vw, 50vw" />
            <figcaption>{w.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {testimonials.length > 0 ? (
    <section class="voices section" aria-labelledby="voices-title">
      <div class="wrap">
        <Tape label="Clients" />
        <h2 id="voices-title" class="sr-only">What clients say</h2>
        <ul class="voices__list">
          {testimonials.map((t) => (
            <li data-reveal>
              <blockquote class="display h-sm">“{t.quote}”</blockquote>
              <p class="muted">{t.name}, {t.source}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : (
    <section class="insta" aria-label="Instagram">
      <div class="wrap insta__inner">
        <p class="display h-sm" data-reveal>New work, cloth and fittings. <span class="soft">Follow the studio on Instagram.</span></p>
        <a class="btn btn--soft" href={site.social.instagram.url} target="_blank" rel="noopener" data-reveal><Icon name="instagram" />{site.social.instagram.handle}</a>
      </div>
    </section>
  )}

  <Visit />
  <CtaBand />
</Base>

<style>
  /* HERO: copy on the left, the 3D cloth fills the right of the viewport */
  .hero { position: relative; padding-top: var(--header-h); min-height: min(100svh, 980px); display: flex; flex-direction: column; }
  .hero__stage { position: absolute; top: 0; right: 0; bottom: 0; width: 58%; z-index: 0; }
  .hero__inner { position: relative; z-index: 1; flex: 1; display: flex; align-items: center; pointer-events: none; }
  .hero__text { max-width: 40rem; padding-block: clamp(2.5rem, 7vw, 5rem); pointer-events: auto; }
  .hero__title { font-size: clamp(2.6rem, 1.6rem + 4.2vw, 5.6rem); margin-bottom: clamp(1.25rem, 2.5vw, 2rem); }
  .hero__lede { max-width: 32ch; margin-bottom: 2rem; }
  .hero__foot { position: relative; z-index: 1; }
  .hero__index { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .hero__index a {
    display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; padding: 1.1rem 1.35rem; border-radius: var(--r);
    background: rgba(246, 246, 247, 0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    transition: background-color 0.3s, transform 0.4s var(--ease-out);
  }
  .hero__index a:hover { background: var(--soft-2); transform: translateY(-2px); }
  .hero__i { grid-row: span 2; font-size: 0.8rem; color: var(--muted); padding-top: 0.2rem; }
  .hero__t { font-weight: 500; line-height: 1.4; }
  .hero__o { font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  @media (max-width: 1023px) {
    .hero { min-height: 0; }
    .hero__stage { position: relative; width: 100%; height: min(105vw, 560px); order: 2; margin-top: -1rem; }
    .hero__inner { order: 1; }
    .hero__foot { order: 3; }
    .hero__text { padding-bottom: 0; }
    .hero__index { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .hero .btn-row .btn { flex: 1 1 100%; } }

  /* STATEMENT */
  .statement__text { font-size: var(--step-3); line-height: 1.22; letter-spacing: -0.03em; margin: 0; max-width: 30ch; }

  /* WHAT WE MAKE */
  .make__title { margin-bottom: clamp(3rem, 7vw, 6rem); max-width: 22ch; }
  .svc { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.4vw, 2.5rem); row-gap: 2rem; margin-bottom: clamp(5rem, 11vw, 9rem); }
  .svc__num { font-size: 0.85rem; color: var(--faint); margin-bottom: 1.25rem; }
  .svc__text :global(.eyebrow), .svc__cols :global(.eyebrow) { margin-bottom: 0.75rem; }
  .svc__text h3, .svc__cols h3 { margin-bottom: 1.25rem; }
  .svc__lede { font-size: var(--step-1); line-height: 1.55; color: var(--ink); margin-bottom: 1rem; max-width: 34ch; }
  .svc__text > .muted { max-width: 46ch; margin-bottom: 1.75rem; }
  .svc--a .svc__media { grid-column: 1 / 8; position: relative; }
  .svc--a .svc__inset { position: absolute; width: 36%; right: -14%; bottom: -3rem; border-radius: var(--r); box-shadow: var(--shadow); }
  .svc--a .svc__text { grid-column: 9 / 13; align-self: center; padding-top: 5rem; }
  .svc--b .svc__text { grid-column: 1 / 6; align-self: center; }
  .svc--b .svc__media { grid-column: 7 / 13; }
  .svc--c { row-gap: 2.5rem; margin-bottom: 0; }
  .svc--c > :global(.frame) { grid-column: 1 / -1; }
  .svc__cols { grid-column: 1 / -1; display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 5vw, 5rem); }
  .svc__cols .muted { max-width: 52ch; }
  @media (max-width: 900px) {
    .svc > * { grid-column: 1 / -1 !important; }
    .svc--a .svc__inset { width: 40%; right: 0.75rem; bottom: -1.75rem; }
    .svc--a .svc__text { padding-top: 2.5rem; }
    .svc--b .svc__media { order: -1; }
    .svc--c > :global(.frame) { aspect-ratio: 4 / 3; }
    .svc__cols { grid-template-columns: 1fr; gap: 0.5rem; }
  }

  /* PROCESS: soft card, white step tiles; swipeable on phones */
  .proc__card { background: var(--soft); border-radius: calc(var(--r) * 1.4); padding: clamp(2rem, 6vw, 5rem); }
  .proc__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .proc__head h2 { max-width: 16ch; }
  .proc__track { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
  .proc__step { background: var(--white); border-radius: var(--r); padding: clamp(1.4rem, 2.5vw, 2rem); min-height: 15rem; display: flex; flex-direction: column; transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease); }
  .proc__step:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .proc__n { font-size: clamp(2.2rem, 3.5vw, 3rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; color: #d9d9de; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .proc__n::before { content: attr(data-n); }
  .proc__t { font-size: var(--step-1); font-weight: 500; letter-spacing: -0.01em; margin-bottom: 0.5rem; }
  .proc__step p { font-size: 0.93rem; line-height: 1.65; margin: 0; }
  .proc__track:focus-visible { outline-offset: 6px; }
  @media (max-width: 900px) {
    .proc__track {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 0.75rem;
      margin-inline: calc(clamp(2rem, 6vw, 5rem) * -1); padding-inline: clamp(2rem, 6vw, 5rem); scroll-padding-inline: clamp(2rem, 6vw, 5rem);
      scrollbar-width: none;
    }
    .proc__track::-webkit-scrollbar { display: none; }
    .proc__step { flex: 0 0 78%; scroll-snap-align: start; min-height: 16rem; }
  }

  /* DETAILS */
  .dets__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 7rem); }
  .dets__sticky { position: sticky; top: calc(var(--header-h) + 2rem); display: grid; }
  .dets__img { grid-area: 1 / 1; opacity: 0; transform: scale(0.98); transition: opacity 0.7s var(--ease), transform 0.9s var(--ease-out); }
  .dets__img.is-active { opacity: 1; transform: none; }
  .dets__lede { margin: 1.5rem 0 2.5rem; }
  .dets__list { display: grid; gap: 0.35rem; }
  .dets__item { display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; padding: 1.2rem 1.35rem; border-radius: var(--r); transition: background-color 0.4s var(--ease); }
  .dets__item dt { font-size: var(--step-1); font-weight: 500; letter-spacing: -0.01em; }
  .dets__item dd { margin: 0; max-width: 44ch; font-size: 0.95rem; }
  .dets__item.is-active { background: var(--soft); }
  @media (max-width: 900px) {
    .dets__grid { grid-template-columns: 1fr; }
    .dets__stage { display: none; }
    .dets__item { grid-template-columns: 1fr; gap: 0.3rem; padding: 1.1rem 1.2rem; background: var(--soft); }
  }

  /* WORK: bento */
  .work__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .work__head :global(.eyebrow) { margin-bottom: 1rem; }
  .work__head h2 { max-width: 16ch; }
  .work__note { margin: 1rem 0 0; font-size: 0.95rem; }
  .work__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(0.6rem, 1.4vw, 1rem); grid-template-rows: repeat(2, clamp(230px, 30vw, 440px)); }
  .work__item { margin: 0; position: relative; min-height: 0; }
  .work__item :global(.frame) { height: 100%; }
  .work__item figcaption {
    position: absolute; left: 0.9rem; top: 0.9rem; padding: 0.35rem 0.8rem; border-radius: 999px;
    background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); font-size: 0.8rem; font-weight: 500;
  }
  .work__item--1 { grid-column: 1 / 6; grid-row: 1 / 3; }
  .work__item--2 { grid-column: 6 / 9; grid-row: 1; }
  .work__item--3 { grid-column: 9 / 13; grid-row: 1; }
  .work__item--4 { grid-column: 6 / 10; grid-row: 2; }
  .work__item--5 { grid-column: 10 / 13; grid-row: 2; }
  @media (max-width: 900px) {
    .work__grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .work__item { grid-column: auto !important; grid-row: auto !important; aspect-ratio: 4 / 5; }
    .work__item--1 { grid-column: 1 / -1 !important; aspect-ratio: 4 / 3; }
  }

  /* VOICES / INSTAGRAM */
  .voices__list { display: grid; gap: 4rem; }
  .voices blockquote { margin: 0 0 1rem; max-width: 30ch; }
  .insta { padding-block: clamp(1rem, 3vw, 2rem); }
  .insta__inner { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem 2rem; flex-wrap: wrap; }
  .insta p { margin: 0; max-width: 34ch; }
</style>

<script>
  // Details: the stage image follows the item under the pointer or in the middle of the viewport.
  const items = document.querySelectorAll<HTMLElement>('[data-detail]');
  const imgs = document.querySelectorAll<HTMLElement>('[data-detail-img]');
  const activate = (i: string) => {
    items.forEach((el) => el.classList.toggle('is-active', el.dataset.detail === i));
    imgs.forEach((el) => el.classList.toggle('is-active', el.dataset.detailImg === i));
  };
  if (items.length && matchMedia('(min-width: 901px)').matches) {
    activate('0');
    items.forEach((el) => el.addEventListener('pointerenter', () => activate(el.dataset.detail!)));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) activate((e.target as HTMLElement).dataset.detail!); });
    }, { rootMargin: '-45% 0px -45% 0px' });
    items.forEach((el) => io.observe(el));
  }
</script>
