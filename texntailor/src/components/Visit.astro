---
import Tape from './Tape.astro';
import Icon from './Icon.astro';
import { site, telLink, whatsappLink, mapsLink, mapsEmbed, addressLine } from '../data/site';
interface Props { heading?: 'h2' | 'h1'; }
const { heading = 'h2' } = Astro.props;
const H = heading;
---
<section class="visit section" aria-labelledby="visit-title" id="visit">
  <div class="wrap">
    <Tape label="The studio" />
    <div class="visit__grid">
      <div class="visit__text">
        <H id="visit-title" class="display h-lg" data-reveal>Visit us in <em>Al&nbsp;Nahda</em></H>
        <p class="lede" data-reveal data-reveal-delay="1">Measurements are best taken in person. Call or message before you come and we will make sure there is time for you.</p>

        <dl class="visit__facts" data-reveal data-reveal-delay="2">
          <div>
            <dt class="label muted">Address</dt>
            <dd><address>{addressLine}<br />{site.address.country}</address></dd>
          </div>
          {site.hours.length > 0 && (
            <div>
              <dt class="label muted">Opening hours</dt>
              <dd>{site.hours.map((h) => <span class="visit__hour"><span>{h.days}</span><span>{h.hours}</span></span>)}</dd>
            </div>
          )}
          <div>
            <dt class="label muted">Telephone</dt>
            <dd><a href={telLink}>{site.contact.phoneDisplay}</a></dd>
          </div>
          {site.contact.email && (
            <div>
              <dt class="label muted">Email</dt>
              <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
            </div>
          )}
        </dl>

        <ul class="visit__actions" data-reveal data-reveal-delay="3" data-wa-zone>
          <li><a class="btn" href={mapsLink} target="_blank" rel="noopener"><Icon name="pin" />Get directions</a></li>
          <li><a class="btn btn--ghost" href={whatsappLink('Hello Tex N Tailor, I would like to visit the studio.')} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a></li>
          <li><a class="btn btn--ghost" href={telLink}><Icon name="phone" />Call</a></li>
        </ul>
      </div>

      <div class="visit__map" data-reveal="img">
        <div class="map" data-map data-src={mapsEmbed}>
          <div class="map__facade">
            <svg class="map__lines" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-width="1">
                <path d="M-10 210 C 90 190, 160 150, 410 120" /><path d="M-10 90 L 410 150" opacity=".6" />
                <path d="M120 -10 L 170 310" opacity=".6" /><path d="M300 -10 C 280 100, 260 200, 240 310" />
                <path d="M-10 40 L 410 60" opacity=".35" /><path d="M40 -10 L 60 310" opacity=".35" />
                <path d="M-10 260 L 410 280" opacity=".35" /><path d="M360 -10 L 350 310" opacity=".35" />
              </g>
            </svg>
            <span class="map__pin"><Icon name="pin" size={30} /></span>
            <button type="button" class="btn map__load" data-map-load>Show map</button>
            <p class="map__note">Loads Google Maps</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .visit__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: stretch; }
  .visit__text { display: grid; gap: 1.75rem; align-content: start; }
  .visit__text .lede { margin: 0; }
  .visit__facts { display: grid; gap: 1.25rem; padding-block: 1.75rem; border-block: 1px solid var(--line); }
  .visit__facts > div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; align-items: baseline; }
  .visit__facts a { text-decoration: none; background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat; }
  .visit__hour { display: flex; justify-content: space-between; gap: 1rem; max-width: 22rem; }
  .visit__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .visit__map { min-height: 420px; }
  .map { position: relative; height: 100%; min-height: 420px; background: var(--linen); overflow: hidden; }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(0.85) contrast(1.05) sepia(0.1); }
  .map__facade { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1rem; color: var(--taupe); }
  .map__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map__pin { position: relative; color: var(--claret); }
  .map__load { position: relative; }
  .map__note { position: relative; margin: 0; font-size: 0.8rem; color: var(--muted); }
  @media (max-width: 900px) {
    .visit__grid { grid-template-columns: 1fr; }
    .visit__map, .map { min-height: 340px; }
    .visit__facts > div { grid-template-columns: 1fr; gap: 0.3rem; }
    .visit__actions .btn { flex: 1 1 auto; }
    .visit__actions li:first-child { flex-basis: 100%; }
    .visit__actions li { flex: 1; } .visit__actions li .btn { width: 100%; }
  }
</style>
<script>
  // Click-to-load map: keeps Google's ~500 KB and cookies off the page until asked for.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = map.dataset.src ?? '';
      f.title = 'Map showing the Tex N Tailor studio in Al Nahda, Dubai';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      map.replaceChildren(f);
      f.focus();
    });
  });
</script>
