---
import Tape from './Tape.astro';
import Icon from './Icon.astro';
import { site, telLink, whatsappLink, mapsLink, mapsEmbed, addressLine } from '../data/site';
---
<section class="visit section" aria-labelledby="visit-title" id="visit">
  <div class="wrap">
    <div class="visit__grid">
      <div class="visit__text">
        <Tape label="The studio" />
        <h2 id="visit-title" class="display h-lg" data-reveal>Visit us in Al&nbsp;Nahda.</h2>
        <p class="lede" data-reveal data-reveal-delay="1">Measurements are best taken in person. Call or message before you come, and we will make sure there is time for you.</p>

        <dl class="visit__facts" data-reveal data-reveal-delay="2">
          <div><dt>Address</dt><dd><address>{addressLine}<br />{site.address.country}</address></dd></div>
          {site.hours.length > 0 && (
            <div><dt>Opening hours</dt><dd>{site.hours.map((h) => <span class="visit__hour"><span>{h.days}</span><span>{h.hours}</span></span>)}</dd></div>
          )}
          <div><dt>Telephone</dt><dd><a href={telLink}>{site.contact.phoneDisplay}</a></dd></div>
          {site.contact.email && <div><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>}
        </dl>

        <ul class="visit__actions" data-reveal data-reveal-delay="3" data-wa-zone>
          <li><a class="btn" href={mapsLink} target="_blank" rel="noopener"><Icon name="pin" />Get directions</a></li>
          <li><a class="btn btn--soft" href={whatsappLink('Hello Tex N Tailor, I would like to visit the studio.')} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a></li>
          <li><a class="btn btn--soft" href={telLink}><Icon name="phone" />Call</a></li>
        </ul>
      </div>

      <div class="visit__map" data-reveal="img">
        <div class="map" data-map data-src={mapsEmbed}>
          <div class="map__facade">
            <span class="map__pin"><Icon name="pin" size={26} /></span>
            <p class="map__place">{site.address.area}, {site.address.city}</p>
            <button type="button" class="btn map__load" data-map-load>Show map</button>
            <p class="map__note">Loads Google Maps</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .visit__grid { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: stretch; }
  .visit__text { display: grid; gap: 1.5rem; align-content: start; }
  .visit__text :global(.eyebrow) { margin: 0; }
  .visit__text .lede { margin: 0; }
  .visit__facts { display: grid; gap: 0.75rem; }
  .visit__facts > div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 1rem; align-items: baseline; }
  .visit__facts dt { font-size: 0.85rem; font-weight: 500; }
  .visit__facts dd { color: var(--muted); }
  .visit__facts a:hover { color: var(--ink); }
  .visit__hour { display: flex; justify-content: space-between; gap: 1rem; max-width: 22rem; }
  .visit__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
  .visit__map { min-height: 460px; }
  .map { position: relative; height: 100%; min-height: 460px; border-radius: calc(var(--r) * 1.4); overflow: hidden; background: radial-gradient(80% 70% at 50% 40%, #fbfbfc, #eef0f3); }
  .map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(1) contrast(1.02) brightness(1.04); }
  .map__facade { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.9rem; text-align: center; }
  .map__pin { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--white); box-shadow: var(--shadow); color: var(--navy); }
  .map__place { margin: 0; font-weight: 500; }
  .map__note { margin: 0; font-size: 0.8rem; color: var(--faint); }
  @media (max-width: 900px) {
    .visit__grid { grid-template-columns: 1fr; }
    .visit__map, .map { min-height: 340px; }
    .visit__facts > div { grid-template-columns: 1fr; gap: 0.1rem; }
    .visit__actions li { flex: 1 1 auto; } .visit__actions li:first-child { flex-basis: 100%; }
    .visit__actions .btn { width: 100%; }
  }
</style>
<script>
  // Click-to-load map: keeps Google's scripts and cookies off the page until asked for.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = map.dataset.src ?? '';
      f.title = 'Map showing the Tex N Tailor studio in Al Nahda, Dubai';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      map.replaceChildren(f);
      f.focus();
    });
  });
</script>
