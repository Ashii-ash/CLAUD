---
/* Typographic wordmark. Replace with the official Tex N Tailor logo file when supplied. */
interface Props { size?: 'sm' | 'lg'; }
const { size = 'sm' } = Astro.props;
---
<span class:list={['wordmark', `wordmark--${size}`]}>TEX<span class="wordmark__n">N</span>TAILOR</span>
<style>
  .wordmark { font-family: var(--f); font-weight: 600; font-size: 1.05rem; letter-spacing: 0.22em; line-height: 1; white-space: nowrap; }
  .wordmark__n { display: inline-grid; place-items: center; width: 1.45em; height: 1.45em; margin: 0 0.45em 0 0.2em; border-radius: 50%; background: var(--ink); color: var(--white); font-size: 0.62em; letter-spacing: 0; vertical-align: 0.12em; }
  .wordmark--lg { font-size: clamp(1.35rem, 3vw, 1.8rem); }
</style>
