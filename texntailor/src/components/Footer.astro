---
import Wordmark from './Wordmark.astro';
import { nav, site, telLink, whatsappLink, mapsLink, addressLine } from '../data/site';
import { services } from '../data/content';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__card">
      <div class="ftr__top">
        <div class="ftr__brand">
          <a href="/" aria-label="Tex N Tailor, home" class="ftr__logo"><Wordmark size="lg" /></a>
          <p class="ftr__statement">Custom suits, wedding attire and everyday clothing, made to measure in Al&nbsp;Nahda, Dubai.</p>
          <a class="btn" href="/contact/#enquire">Book an appointment</a>
        </div>

        <nav class="ftr__col" aria-label="Footer">
          <p class="ftr__h">Explore</p>
          <ul>
            <li><a href="/">Home</a></li>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>

        <div class="ftr__col">
          <p class="ftr__h">Tailoring</p>
          <ul>{services.map((s) => <li><a href={`/tailoring/#${s.id}`}>{s.title}</a></li>)}</ul>
        </div>

        <div class="ftr__col" data-wa-zone>
          <p class="ftr__h">Contact</p>
          <ul>
            <li><a href={telLink}>{site.contact.phoneDisplay}</a></li>
            <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
            {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
            <li><a href={site.social.instagram.url} target="_blank" rel="noopener">Instagram</a></li>
          </ul>
        </div>

        <div class="ftr__col">
          <p class="ftr__h">Studio</p>
          <address><a href={mapsLink} target="_blank" rel="noopener">{addressLine}<br />{site.address.country}</a></address>
          {site.hours.length > 0 && (
            <dl class="ftr__hours">{site.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.hours}</dd></>))}</dl>
          )}
        </div>
      </div>
    </div>

    <div class="ftr__base">
      <p>© {year} {site.legalName ?? site.name}</p>
      <ul>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>
<style>
  .ftr { padding-bottom: max(1.5rem, calc(env(safe-area-inset-bottom) + 5rem)); }
  .ftr__card { background: var(--soft); border-radius: calc(var(--r) * 1.4); padding: clamp(2.25rem, 6vw, 5rem); }
  .ftr__top { display: grid; grid-template-columns: 1.7fr repeat(4, 1fr); gap: clamp(2rem, 4vw, 3.5rem); }
  .ftr__brand { display: grid; gap: 1.5rem; align-content: start; justify-items: start; padding-right: 2rem; }
  .ftr__statement { color: var(--muted); max-width: 30ch; margin: 0; }
  .ftr__h { font-size: 0.85rem; font-weight: 500; color: var(--ink); margin-bottom: 1rem; }
  .ftr__col ul { display: grid; gap: 0.4rem; }
  .ftr__col a { color: var(--muted); display: inline-block; padding-block: 0.2rem; overflow-wrap: anywhere; transition: color 0.25s; }
  .ftr__col a:hover { color: var(--ink); }
  .ftr__hours { display: grid; grid-template-columns: auto auto; gap: 0.25rem 1rem; margin-top: 1rem; color: var(--muted); font-size: 0.9rem; }
  .ftr__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: 1.75rem 0.5rem 0; font-size: 0.85rem; color: var(--faint); }
  .ftr__base p { margin: 0; }
  .ftr__base ul { display: flex; gap: 1.5rem; }
  .ftr__base a:hover { color: var(--ink); }
  @media (max-width: 1100px) { .ftr__top { grid-template-columns: repeat(2, 1fr); } .ftr__brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ftr__top { gap: 2.25rem 1.25rem; } }
</style>
